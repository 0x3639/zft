{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zft-devnet",
  "main": "apps/api/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": { "PUBLIC_ORIGIN": "https://zft.foo", "SPONSOR_ENABLED": "false" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "zft-devnet-public" }],
  "durable_objects": {
    "bindings": [{ "name": "SPONSOR", "class_name": "Sponsor" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sponsor"] }],
  "observability": { "enabled": false },
  "env": {
    "local": {
      "vars": {
        "PUBLIC_ORIGIN": "http://localhost:5173",
        "SPONSOR_ENABLED": "false",
      },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "zft-local-public" }],
      "durable_objects": {
        "bindings": [{ "name": "SPONSOR", "class_name": "Sponsor" }],
      },
    },
  },
}
