{
  "name": "zft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite node_modules/vitest/vitest.mjs run",
    "contracts:build": "node scripts/compile-contract.mjs",
    "contracts:test": "node node_modules/@foundry-rs/forge/bin.mjs test -vv",
    "worker:dev": "wrangler dev --config wrangler.devnet.jsonc --env local --port 8787",
    "worker:check": "wrangler deploy --config wrangler.devnet.jsonc --env= --dry-run --outdir dist/worker",
    "deploy:contract": "tsx scripts/deploy-contract.ts",
    "deploy": "pnpm build && wrangler deploy --config wrangler.devnet.jsonc --env=",
    "format": "prettier --write 'apps/**/*.{ts,tsx,css,html}' 'packages/**/*.{ts,json}' 'scripts/*.{ts,mjs}' 'tests/*.ts' package.json tsconfig.json vitest.config.ts wrangler.devnet.jsonc"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@openzeppelin/contracts": "5.6.1",
    "@resvg/resvg-wasm": "2.6.2",
    "fast-png": "8.0.0",
    "idb": "8.0.3",
    "jpeg-js": "0.4.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "satori": "0.26.0",
    "viem": "2.57.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@types/node": "22.18.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.4",
    "prettier": "3.6.2",
    "solc": "0.8.30",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "wrangler": "4.147.0"
  }
}
