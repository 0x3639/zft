{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zft-shielded-devnet-test",
  "main": "worker-entry.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "build/candidate/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "routes": [{ "pattern": "devnet.zft.foo/shielded*", "zone_name": "zft.foo" }],
  "observability": { "enabled": false },
}
